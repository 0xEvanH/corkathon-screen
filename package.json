{
  "name": "corkathon-clock",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --port=4173 ./index.html",
    "build": "rm -rf dist && bun build ./index.html --outdir=dist --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "e2e": "playwright test",
    "check": "bun run typecheck && bun run test && bun run e2e && bun run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
