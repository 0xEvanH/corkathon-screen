{
  "name": "corkathon-clock",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "bun --bun vite --port 4173",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "e2e": "playwright test",
    "check": "bun run typecheck && bun run test && bun run e2e && bun run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@vitejs/plugin-react": "6.2.1",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "vite": "8.3.6"
  }
}
